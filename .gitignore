# Large / gated inputs — never commit weights or dataset shards.
# Leading slash anchors these to the repo root: an unanchored `data/` also
# matches `src/edr/data/`, which silently drops a source package from the commit.
/data/
/weights/
*.npz
*.safetensors

# Hand labels ARE source and must be committed; only ignore scratch
calibration/scratch/
